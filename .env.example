# Copy this file to .env and adjust it before starting the stack.
POSTGRES_DB=face_recogniser
POSTGRES_USER=face_recogniser
POSTGRES_PASSWORD=change-this-password

# URL as reached from inside the API container. If Stash is another Compose
# service on the same network, use its service name (for example http://stash:9999).
STASH_URL=http://host.docker.internal:9999
STASH_API_KEY=

# Translate paths returned by Stash into paths visible inside this app.
STASH_PATH_PREFIX=/data
MEDIA_PATH_PREFIX=/media

# Host folders mounted by Compose.
MEDIA_LIBRARY_PATH=/data
APPDATA_PATH=./appdata
FRAME_SCAN_FPS=2
FRAME_SAMPLE_INTERVAL_SECONDS=30
FRAME_SCENE_THRESHOLD=0.35
MAX_FRAMES_PER_VIDEO=300
FRAME_MAX_WIDTH=1920
PROCESSING_JOB_TIMEOUT_SECONDS=21600

# Browser-facing port and optional CORS origins (comma separated).
WEB_PORT=8787
CORS_ORIGINS=http://localhost:8787
LOG_LEVEL=INFO

# Intra-video appearance assistance only; never used for Person suggestions.
APPEARANCE_ENABLED=true
APPEARANCE_CROP_SIDE=0.75
APPEARANCE_CROP_ABOVE=0.25
APPEARANCE_CROP_BELOW=2.0
GROUPING_ASSISTED_MIN=0.45
GROUPING_APPEARANCE_MIN=0.90
GROUPING_ASSISTED_SECONDS=30
GROUPING_DUPLICATE_MIN=0.97
GROUPING_DUPLICATE_SECONDS=3
